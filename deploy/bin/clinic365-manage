#!/usr/bin/env bash
# Run a Django management command with the production environment loaded.
#   clinic365-manage migrate
#   clinic365-manage purge_notifications --dry-run
# Install: sudo install -m 755 deploy/bin/clinic365-manage /usr/local/bin/clinic365-manage
#
# Reads KEY=value lines from the env file without executing it, so values may contain spaces,
# '<', '>' or '#' (unlike `source`). Comment lines and blank lines are skipped.
set -euo pipefail

APP="${CLINIC365_APP:-/opt/clinic365/clinic365}"
VENV="${CLINIC365_VENV:-/opt/clinic365/venv}"
ENVFILE="${CLINIC365_ENV:-/etc/clinic365/clinic365.env}"

if [[ ! -r "$ENVFILE" ]]; then
  echo "clinic365-manage: cannot read $ENVFILE (run as the clinic365 user or root)" >&2
  exit 1
fi

while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%$'\r'}"
  [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
  key="${line%%=*}"
  value="${line#*=}"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  export "$key=$value"
done < "$ENVFILE"

cd "$APP"
exec "$VENV/bin/python" manage.py "$@"
