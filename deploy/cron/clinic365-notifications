# Clinic365 EMR: daily clean-up of old notifications (top-bar bell).
#
# Install on the Linux server (as root):
#   1. Edit APP, VENV and RUN_AS below to match the server.
#   2. sudo cp deploy/cron/clinic365-notifications /etc/cron.d/clinic365-notifications
#   3. sudo chmod 644 /etc/cron.d/clinic365-notifications     (cron ignores group/world-writable files)
#   4. sudo mkdir -p /var/log/clinic365 && sudo chown <RUN_AS user> /var/log/clinic365
#   Test once by hand:
#      cd $APP && $VENV/bin/python manage.py purge_notifications --dry-run --settings=clinic365.settings_production
#
# Files in /etc/cron.d need the user column (here: clinic365) and must end with a newline.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
APP=/opt/clinic365/clinic365
VENV=/opt/clinic365/venv

# Every day at 02:30 (server time): delete read notifications older than 90 days,
# unread ones older than 365 days.
30 2 * * * clinic365 cd $APP && $VENV/bin/python manage.py purge_notifications --settings=clinic365.settings_production >> /var/log/clinic365/purge_notifications.log 2>&1
