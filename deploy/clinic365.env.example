# Clinic365 EMR - production environment.
# Copy to /etc/clinic365/clinic365.env, fill in every value, then:
#   sudo chown root:clinic365 /etc/clinic365/clinic365.env && sudo chmod 640 /etc/clinic365/clinic365.env
# (it holds the database password and secret key: readable by the app user only).
# Format: plain KEY=value lines, no quotes, no "export" (read by systemd, cron and the shell).

DJANGO_SETTINGS_MODULE=clinic365.settings_production

# Long random value. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later signs everyone out of the old Django sessions (app logins use tokens and survive).
DJANGO_SECRET_KEY=

# Names / IPs the server is reached by, comma separated (no scheme, no port).
DJANGO_ALLOWED_HOSTS=192.168.2.14,localhost
# The same, as full browser origins (scheme + host + port if not 80/443).
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.2.14,http://localhost

# Set to 1 only after nginx serves the site over HTTPS.
DJANGO_HTTPS=0

# PostgreSQL
DB_NAME=clinic365
DB_USER=clinic365
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Paths (create them and give the clinic365 user write access to media and logs)
DJANGO_STATIC_ROOT=/opt/clinic365/staticfiles
DJANGO_MEDIA_ROOT=/opt/clinic365/media
DJANGO_LOG_DIR=/var/log/clinic365
DJANGO_LOG_LEVEL=INFO

# Email for the nightly day-book report (leave EMAIL_HOST empty to only log it).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Clinic365 EMR <no-reply@example.com>
DAY_BOOK_EMAIL=

# Never 1 on the live server (shows code and settings to anyone who triggers an error).
DJANGO_DEBUG=0

# Old Django pages outside /api/ (the React app does not use them).
# readonly = signed-in staff may view them but not change anything (default); login = full use (no history kept);
# off = closed for everyone (recommended once nobody uses them).
DJANGO_LEGACY_PAGES=readonly

# Backups (deploy/bin/clinic365-backup, deploy/cron/clinic365-backup). See README, section Backups.
BACKUP_DIR=/var/backups/clinic365
# OFF-SITE copy: REQUIRED for real protection. One or both of:
#   BACKUP_REMOTE=backup@10.0.0.20:/srv/clinic365-backups     (another machine, over ssh/rsync)
#   BACKUP_REMOTE=/mnt/backupdisk/clinic365                   (a mounted USB/NAS disk; folder must exist)
#   BACKUP_RCLONE=gdrive:clinic365-backups                    (cloud, after `rclone config`)
BACKUP_REMOTE=
BACKUP_RCLONE=
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_MEDIA=7
# Who is emailed when backups need attention (needs EMAIL_HOST). Admin/CMD always get a bell notification.
BACKUP_ALERT_EMAIL=
